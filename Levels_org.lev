LSUX 1
EQSP LEV,EQN,#9000019930EQNSET 1 "Eq_Contact"

SPECS
	vdd_cont [V]        #supply voltage contact test
	idd_cont [mA]       #supply current contact test
	vil_cont [V]        #low level input voltage contact test
	vih_cont [V]        #high level input voltage contact test
	vol_cont [V]        #low level output voltage contact test
	voh_cont [V]        #high level output voltage contact test
    iol_cont [mA]       #low level output current contact test
	ioh_cont [mA]       #high level output current contact test
	vt_cont  [V]        #termination voltage contact test


DPSPINS DPS_VBOOST


	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 4.0	
#	iout_clamp_rng = 1
	

DPSPINS DPS_VBAT

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 1

DPSPINS DPS_VANA

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 1

DPSPINS DPS_DVDD_LP

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 1.2
#	iout_clamp_rng = 1

DPSPINS DPS_VBAT_RTC

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 1
	
DPSPINS DPS_VDIG

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 1

DPSPINS DPS_VDD_ANALOG

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7	
#	iout_clamp_rng = 1

DPSPINS DPS_VCC_ANA

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 0.2

DPSPINS DPS_PVDD

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 1

DPSPINS DPS_AVD

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7
#	iout_clamp_rng = 1

DPSPINS DPS_DVD

	vout    = vdd_cont
	ilimit  = idd_cont
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 1.2
#	iout_clamp_rng = 1


LEVELSET 1 "Contact_LS"

PINS ALLPINS
	vil = vil_cont
	vih = vih_cont
	vol = vol_cont
	voh = voh_cont
	iol = iol_cont
	ioh = ioh_cont
	vt  = vt_cont

LEVELSET 2 "FuncLower_conti_LS"

PINS FUNC_LOWER_CONTI
	vil = vil_cont
	vih = vih_cont
	vol = vol_cont
	voh = voh_cont
	iol = iol_cont
	ioh = ioh_cont
	vt  = vt_cont

PINS RF_GROUP

vil = vil_cont
	vih = vih_cont
	vol = -1.5
	voh = 1.5
	iol = 0.03
	ioh = 0.03
	vt  = vt_cont

PINS VBOOST_VDIG_PVDD_GROUP
vil = vil_cont
	vih = vih_cont
	vol = -1.5
	voh = 3
	iol = 0.001
	ioh = 0.001
	vt  = vt_cont

PINS MCE_TRIGGER
	vil = -1
	vih = 1
	vol = 0.0
	voh = 0.0
	ioh = 0.0
	vt  = 0.0


PINS RF_TRIG
	vil = 0
	vih = 3
	vol = 0.5
	voh = 2.2
	iol = 0
	ioh = 0
	vt  = 0


LEVELSET 3 "FuncUpper_conti_LS"

PINS FUNC_UPPER_CONTI
	vil = vil_cont
	vih = vih_cont
	vol = vol_cont
	voh = voh_cont
	iol = iol_cont
	ioh = ioh_cont
	vt  = vt_cont

PINS ANT

	vil = vil_cont
	vih = vih_cont
	vol = -1.5
	voh = 1.5
	iol = 0.03
	ioh = 0.03
	vt  = vt_cont

PINS VBOOST_VDIG_PVDD_GROUP
	vil = vil_cont
	vih = vih_cont
	vol = -1.5
	voh = 3
	iol = 0.001
	ioh = 0.001
	vt  = vt_cont

PINS XIN_XTAL_GROUP
   	vil = vil_cont
	vih = vih_cont
	vol = 0.1
	voh = 3
    	iol = iol_cont
	ioh = ioh_cont
	vt  = vt_cont

PINS VSCAP
   	vil = vil_cont
	vih = vih_cont
	vol = -1.5
	voh = 3
    	iol = iol_cont
	ioh = ioh_cont
	vt  = vt_cont

PINS MCE_TRIGGER
	vil = -1
	vih = 1
	vol = 0.0
	voh = 0.0
	ioh = 0.0
	vt  = 0.0


PINS RF_TRIG
	vil = 0
	vih = 3
	vol = 0.5
	voh = 2.2
	iol = 0
	ioh = 0
	vt  = 0

EQNSET 2 "Eq_Func"

SPECS

	vdd_boost   [V]  #supply voltage VBOOST
	idd_boost  [mA] #supply current VBOOST
	vdd_bbst_sw  [V]  #supply voltage DPS_BBST_SW
	idd_bbst_sw  [mA] #supply current DPS_BBST_SW
	vdd_bat  [V]  #supply voltage VBAT
	idd_bat  [mA] #supply current VBAT
	vdd_ana [V]  #supply voltage VANA
	idd_ana [mA] #supply current VANA
	vdd_DVDD_LP [V]  #supply voltage DPS_DVDD_LP
	idd_DVDD_LP [mA] #supply current DPS_DVDD_LP

    vdd_vcc_ana   [V]  #supply voltage VCC_ANA
	idd_vcc_ana  [mA] #supply current VCC_ANA
	vdd_dig  [V]  #supply voltage VDIG
	idd_dig  [mA] #supply current VDIG
	vdd_bat_rtc  [V]  #supply voltage VBAT_RTC
	idd_bat_rtc  [mA] #supply current VBAT_RTC
	vdd_analog [V]  #supply voltage VDD_ANALOG
	idd_analog [mA] #supply current VDD_ANALOG

    vdd_pvdd  [V]  #supply voltage DPS_PVDD
	idd_pvdd  [mA] #supply current DPS_PVDD
	vdd_avd [V]  #supply voltage AVD
	idd_avd  [mA] #supply current AVD

	vdd_DVD [V]  #supply voltage DPS_DVD
	idd_DVD [mA] #supply current DPS_DVD
	
	vrst   [V] #voltage for RST_BI limited to 3.6V
	vmcldo [V] #voltage of VMC_LDO
	
	f_vil []   #factor for vil 
	f_vih []   #factor for vih
	f_vol []   #factor for vol
	f_voh []   #factor for voh
	f_vt  []   #factor for vt 

    iol_func  [mA]  #low evel output current 
	ioh_func  [mA]  #high level output current
	
	vil_default [V]
	vih_default [V]
	vol_default [V]
	voh_default [V]
	vt_default  [V]
	iol_default [mA]
	ioh_default [mA]

	vil_trigger [V]   #low level input trigger MCB pins
	vih_trigger [V]   #high level input voltage trigger MCB pins
	vol_trigger [V]   #low level output voltage trigger MCB pins
	voh_trigger [V]   #high level output voltage trigger MCB pins
    iol_trigger [mA]  #low level output current trigger MCB pins
	ioh_trigger [mA]  #high level output current trigger MCB pins
	vt_trigger  [V]   #termination voltage trigger MCB pins
	

DPSPINS DPS_VBOOST

	vout    = vdd_boost
	ilimit  = idd_boost
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 4.0		

		

DPSPINS DPS_VBAT

	vout    = vdd_bat
	ilimit  = idd_bat
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 3.7	

DPSPINS DPS_VANA

	vout    = vdd_ana
	ilimit  = idd_ana
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 3.7	

DPSPINS DPS_DVDD_LP

	vout    = vdd_DVDD_LP
	ilimit  = idd_DVDD_LP
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 1.2	
	
DPSPINS DPS_VBAT_RTC

	vout    = vdd_bat_rtc
	ilimit  = idd_bat_rtc
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 3.7

DPSPINS DPS_VDIG

	vout    = vdd_dig
	ilimit  = idd_dig
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7		

DPSPINS DPS_VDD_ANALOG

	vout    = vdd_analog
	ilimit  = idd_analog
	t_ms    = 0.2
	offcurr = act
	vout_frc_rng = 3.7		

DPSPINS DPS_VCC_ANA

	vout    = vdd_vcc_ana
	ilimit  = idd_vcc_ana
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 3.7	

DPSPINS DPS_PVDD

	vout    = vdd_pvdd
	ilimit  = idd_pvdd
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 3.7	
	
DPSPINS DPS_AVD

	vout    = vdd_avd
	ilimit  = idd_avd
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 3.7	

DPSPINS DPS_DVD

	vout    = vdd_DVD
	ilimit  = idd_DVD
	t_ms    = 0.2
	offcurr = act	
	vout_frc_rng = 1.2	
	

LEVELSET 1 "FuncLS"



PINS GPIO_WO_TRIGGER -( XIN XOUT XTAL_I_RTC XTAL_O_RTC ) # remove clocks
	vil = f_vil*(vdd_boost-0.3)
	vih = f_vih*(vdd_boost-0.3)
	vol = f_vol*(vdd_boost-0.3)
	voh = f_voh*(vdd_boost-0.3)
#	iol = iol_func
#	ioh = ioh_func
#	vt = f_vt*vdd_boost


PINS XTAL_I_RTC XTAL_O_RTC   #32.768 KHz FRC
	vil = 0
	vih = 0.25
	vol = 0
	voh = 0.25


PINS XIN XOUT    #32 MHz FRC
	vil = 0
	vih = 0.9
	vol = 0
	voh = 0.9


PINS MCE_TRIGGER
	vil = vil_trigger
	vih = vih_trigger
	vol = vol_trigger
	voh = voh_trigger
	iol = iol_trigger
	ioh = ioh_trigger
	vt  = vt_trigger

PINS RF_TRIG
	vil = 0
	vih = 3
	vol = 0.5
	voh = 2.2
	iol = iol_trigger
