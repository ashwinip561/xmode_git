hp93000,timing,0.1
EQSP TIM,WVT,#9000001299
WAVETBL wsg_main2
DEFINES MAIN_PORT2

PINS ALL_WO_XTAL -(  TCK_GPIO55  SPI_CLK_UART2_TX SEG5_GPIO16 ATST0_GPIO0 MCE_Trigger_AWG MCE_Trigger_DIG MCE_Trigger_AWG_S2 ) # except CLK and  TMU pins

0   "d1:F00 r1:X"   0
1   "d1:F10 r1:X"   1
2   "d1:F0Z r1:X"   Z
3   "d1:F0Z r1:H"   H
4   "d1:F0Z r1:L"   L
5   "d1:F0Z r1:M"   M
6   "d1:F0Z r1:X"   X
7   "d1:F0Z r1:C"   C
brk "d1:N  "    #undefined


STATEMAP

#PhxSeq # StateChar xmode
0   0   x1
1   1   x1
2   Z   x1
3   H   x1
4   L   x1
5   M   x1
6   X   x1
7   C   x1


PINS TCK_GPIO55  SPI_CLK_UART2_TX     #CLK Pins

0   "d1:F00 d2:F0N r1:X"    0
1   "d1:F10 d2:F0N r1:X"    1
2   "d1:F0Z d2:F0N r1:X"    Z
3   "d1:F0Z d2:F0N r1:H"    H
4   "d1:F0Z d2:F0N r1:L"    L
5   "d1:F0Z d2:F0N r1:M"    M
6   "d1:F0Z d2:F0N r1:X"    X
brk "d1:N  "    #undefined


STATEMAP

#PhxSeq # StateChar xmode
0   0   x1
1   1   x1
2   Z   x1
3   H   x1
4   L   x1
5   M   x1
6   X   x1


PINS SEG5_GPIO16 ATST0_GPIO0  # TMU Pin

0   "d1:F00 r1:X"   0
1   "d1:F10 r1:X"   1
2   "d1:F0Z r1:X"   Z
3   "d1:F0Z r1:H"   H
4   "d1:F0Z r1:L"   L
5   "d1:F0Z r1:M"   M
6   "d1:F0Z r1:X"   X
7	"d1:F0Z r7:ARM"	A
brk "d1:N  "    #undefined


STATEMAP

#PhxSeq # StateChar xmode
0   0   x1
1   1   x1
2   Z   x1
3   H   x1
4   L   x1
5   M   x1
6   X   x1
7   A   x1


@

NOOP "7.6.2",,,
