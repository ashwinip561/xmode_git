hp93000,timing,0.1
EQSP TIM,EQN,#9000000562
EQNSET 2 Eq_scan_wsg

SPECS

#SPECNAME           UNIT
scan_per            [ns]
scan_clk_rdrv           []
scan_clk_dc             []
scan_clk_rstr           []
scan_default_rdrv       []
scan_default_rstr       []


TIMINGSET 1 "scan_wsg:ws_scan"

period = scan_per


PINS ALLPINS  -(  TCK_GPIO55  COM2_GPIO9 COM3_GPIO10 ) # except CLK pins

d1=scan_default_rdrv* scan_per 
r1=scan_default_rstr* scan_per


PINS  TCK_GPIO55  COM2_GPIO9 COM3_GPIO10  # CLK pins

d1=scan_clk_rdrv* scan_per 
d2=(scan_clk_rdrv+scan_clk_dc)* scan_per
r1=scan_clk_rstr* scan_per



@



EQSP TIM,SPS,#9000001217
EQNSET 2 Eq_scan_wsg
WAVETBL "wsg_scan"

CHECK all

SPECSET 1 "scan_spec"


# SPECNAME       *****ACTUAL***** *****MINIMUM**** *****MAXIMUM**** UNITS COMMENT
scan_per         100                                                [ ns] #10MHz
scan_clk_rdrv    0.6              0                0                [   ] 
scan_clk_dc      0.2                                                [   ] 
scan_clk_rstr    0.9                                                [   ] 
scan_default_rdrv 0                                                  [   ] 
scan_default_rstr 0.45                                               [   ] 


WAVETBL "wsg_bscan"

CHECK all

SPECSET 2 "bscan_spec"


# SPECNAME       *****ACTUAL***** *****MINIMUM**** *****MAXIMUM**** UNITS COMMENT
scan_per         100                                                [ ns] #10MHz
scan_clk_rdrv    0.2                                                [   ] 
scan_clk_dc      0.5                                                [   ] 
scan_clk_rstr    0.9                                                [   ] 
scan_default_rdrv 0.2                                                [   ] 
scan_default_rstr 0.45                                               [   ]

@

NOOP "7.6.2",,,
